# =====================================================================
# BHOOMIRAKSHAK ROOT ENVIRONMENT CONFIGURATION (SIH26001)
# =====================================================================
# Note: Every key is configured for immediate local execution with 
# graceful degradation. When a key is missing, BhoomiRakshak logs honest
# 'not_configured' status badges without simulating fake data or crashing.
# =====================================================================

# 1. CORE SERVER & AUTHENTICATION
PORT=5000
NODE_ENV=development
JWT_SECRET=bhoomirakshak-disaster-defense-secret-key-2026
BACKEND_API_URL=http://127.0.0.1:5000/api
ML_SERVICE_URL=http://127.0.0.1:8000

# 2. SUPABASE POSTGRESQL + POSTGIS (Optional: falls back to embedded engine)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# 3. SATELLITE & WEATHER PRECIPITATION FEEDS
# Open-Meteo runs free without API keys for NER coordinates.
OPENWEATHER_API_KEY=
WEATHER_API_KEY=
NASA_EARTHDATA_TOKEN=
EARTHDATA_USERNAME=

# 4. GOOGLE EARTH ENGINE & CLOUD SERVICE ACCOUNT
# Provide relative or absolute path to service account JSON key:
GEE_SERVICE_ACCOUNT_KEY=./gee_service_account.json
GOOGLE_APPLICATION_CREDENTIALS=./gee_service_account.json

# 5. EMERGENCY SMS GATEWAY (Twilio OR MSG91 v5 Flow API)
# Option A: MSG91
MSG91_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=BHRKSH
MSG91_TEMPLATE_ID=

# Option B: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 6. EMERGENCY EMAIL DISPATCH (Nodemailer SMTP / SendGrid / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BhoomiRakshak Disaster Sentinel <alerts@bhoomirakshak.in>"

# 7. WEB PUSH & BROWSER NOTIFICATIONS (VAPID / Firebase FCM v1)
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase_service_account.json
FCM_PROJECT_ID=
FCM_SERVER_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bhoomirakshak.in

# 8. MAP TILES (Optional: defaults to free CartoDB Voyager / OSM Leaflet)
MAPBOX_TOKEN=
VITE_MAPBOX_TOKEN=

