# =====================================================================
# BHOOMIRAKSHAK BACKEND SERVER CONFIGURATION (SIH26001)
# =====================================================================

# 1. CORE SERVER & AUTHENTICATION
PORT=5000
NODE_ENV=development
JWT_SECRET=your-secure-jwt-secret-key
BACKEND_API_URL=http://127.0.0.1:5000/api
ML_SERVICE_URL=http://127.0.0.1:8000

# 2. SUPABASE POSTGRESQL + POSTGIS (Optional: falls back to embedded engine)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. WEATHER & PRECIPITATION TELEMETRY
OPENWEATHER_API_KEY=
WEATHER_API_KEY=
NASA_EARTHDATA_TOKEN=
EARTHDATA_USERNAME=

# 4. GOOGLE EARTH ENGINE & CLOUD SERVICE ACCOUNT
# Path to service account JSON file
GEE_SERVICE_ACCOUNT_KEY=./gee_service_account.json
GOOGLE_APPLICATION_CREDENTIALS=./gee_service_account.json

# 5. EMERGENCY SMS GATEWAYS
# Option A: MSG91 (Flow v5 API)
MSG91_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=BHRKSH
MSG91_TEMPLATE_ID=

# Option B: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 6. EMERGENCY EMAIL DISPATCH (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BhoomiRakshak Sentinel <alerts@bhoomirakshak.in>"

# 7. WEB PUSH NOTIFICATIONS & FIREBASE CLOUD MESSAGING (FCM)
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase_service_account.json
FCM_PROJECT_ID=
FCM_SERVER_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bhoomirakshak.in

# 8. MAP TILES (Optional)
MAPBOX_TOKEN=
VITE_MAPBOX_TOKEN=
