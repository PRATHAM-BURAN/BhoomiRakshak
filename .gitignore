# ==============================================================================
# BhoomiRakshak - Root .gitignore
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env.*
*.env
local.env
!.env.example
!.env.*.example

# --- Service Accounts & Private Keys ---
*service_account*.json
firebase_service_account.json
gee_service_account.json
credentials.json
*.pem
*.key
*.cert
*.p12

# --- Dependencies & Package Managers ---
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build & Output Artifacts ---
dist/
*/dist/
build/
*/build/
.cache/
.vite/

# --- Python & ML Caches ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# --- Temporary & Upload Storage ---
server/uploads/*
!server/uploads/.gitkeep
server/data/*.json
!server/data/.gitkeep
*.sqlite
*.sqlite3
*.db
ml_service/data/cache/

# --- Large Archives & Binary Packages ---
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
