# BhoomiRakshak Frontend Client Environment Configuration
# Optional: Provide Supabase credentials if connecting directly from client for realtime alerts.
# If omitted or left empty, client uses WebSocket connection to the local backend proxy.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Mapbox vector tile access token (defaults to free CartoDB Voyager / OpenStreetMap)
VITE_MAPBOX_TOKEN=
