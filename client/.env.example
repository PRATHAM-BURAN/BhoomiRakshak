# BhoomiRakshak Frontend Client Environment Configuration

# Backend API & WebSocket URLs (for production deployment e.g. Vercel)
# If left blank in local development, Vite proxies /api and /ws to http://localhost:5000
VITE_API_URL=
VITE_WS_URL=

# Optional: Provide Supabase credentials if connecting directly from client for realtime alerts.
# If omitted or left empty, client uses WebSocket connection to the backend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Mapbox vector tile access token (defaults to free CartoDB Voyager / OpenStreetMap)
VITE_MAPBOX_TOKEN=

